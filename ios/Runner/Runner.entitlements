<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications (APNs). Xcode switches this to "production" when archiving for the App Store. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal Links. Requires /.well-known/apple-app-site-association on jodealz.online. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:jodealz.online</string>
	</array>
	<!-- Sign in with Apple (App Store Guideline 4.8). -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
